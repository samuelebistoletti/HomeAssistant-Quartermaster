{
  "services": {
    "adjust_stock": {
      "service": "mdi:basket-minus"
    },
    "undo_last": {
      "service": "mdi:undo"
    },
    "set_stock": {
      "service": "mdi:counter"
    },
    "add_product": {
      "service": "mdi:basket-plus"
    },
    "set_essential": {
      "service": "mdi:star"
    },
    "export_data": {
      "service": "mdi:database-export"
    },
    "import_data": {
      "service": "mdi:database-import"
    },
    "add_zone": {
      "service": "mdi:fridge-outline"
    },
    "remove_zone": {
      "service": "mdi:delete-outline"
    },
    "get_suggestions": {
      "service": "mdi:lightbulb-on-outline"
    },
    "refresh_shopping_list": {
      "service": "mdi:refresh"
    },
    "start_shopping": {
      "service": "mdi:cart-arrow-right"
    },
    "add_to_shopping_list": {
      "service": "mdi:cart-plus"
    },
    "import_from_todo": {
      "service": "mdi:clipboard-arrow-down-outline"
    },
    "ask": {
      "service": "mdi:chat-question-outline"
    },
    "analyze_image": {
      "service": "mdi:image-search-outline"
    },
    "confirm_pending": {
      "service": "mdi:check-all"
    }
  },
  "entity": {
    "todo": {
      "shopping_list": {
        "default": "mdi:cart"
      }
    },
    "sensor": {
      "to_buy": {
        "default": "mdi:cart-alert"
      },
      "suggestions": {
        "default": "mdi:lightbulb-on-outline"
      },
      "expiring": {
        "default": "mdi:calendar-alert"
      },
      "pending_proposals": {
        "default": "mdi:clipboard-check-outline"
      },
      "analyses_today": {
        "default": "mdi:robot-outline"
      }
    },
    "button": {
      "start_shopping": {
        "default": "mdi:cart-arrow-right"
      },
      "undo_last": {
        "default": "mdi:undo"
      }
    },
    "select": {
      "update_mode": {
        "default": "mdi:check-decagram-outline"
      }
    },
    "calendar": {
      "expiry": {
        "default": "mdi:calendar-clock"
      }
    }
  }
}
