#!/usr/bin/env python3
"""
Generate the Alexa interaction models and the intent_script example.

Alexa sends a skill only the intent name and the slot values, never the whole
sentence, and a free-text slot (AMAZON.SearchQuery) needs a carrier word in
front of it. The carrier word is therefore lost, and with it the meaning:
"se ho finito la mozzarella" (a question) would reach Quartermaster as
"ho finito la mozzarella" (a statement). Each carrier word gets its own intent,
and its intent_script puts the word back in front of the slot text.

    scripts/alexa-models           # write examples/alexa/
    scripts/alexa-models --check   # exit 1 if the files are out of date
"""

from __future__ import annotations

import json
from pathlib import Path
import sys
import unicodedata

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "examples" / "alexa"

# Carrier words. Never drop one that changes the meaning: with the word put
# back in front of the text, "non" is safe ("non ho più latte").
LOCALES: dict[str, dict] = {
    "it": {
        "locales": ["it-IT"],
        "invocation": "dispensa smart",
        "carriers": [
            "se", "che", "di", "ho", "abbiamo", "non", "ci", "c'è", "devo",
            "cosa", "quanto", "quanta", "quanti", "quante", "dove",
            "aggiungi", "segna", "metti", "togli", "controlla", "compra",
            "segnare", "aggiungere", "togliere",
            "il", "la", "lo", "i", "gli", "le", "un", "una", "uno",
            "quello", "quella", "quelli", "quelle",
            "nel", "nella", "in", "sono", "ne", "mi", "puoi", "dimmi", "fammi",
            "sì",
        ],
        "yes": ["sì", "si", "certo", "va bene", "esatto", "giusto", "ok", "sì grazie", "confermo"],
        "no": ["no", "no grazie", "non ora", "lascia stare", "niente"],
        # "And then?": the rest of a list read by voice. No sample may start
        # with a carrier word.
        "more": ["e poi", "continua", "vai avanti", "avanti", "e gli altri", "altri", "e dopo"],
    },
    "en": {
        "locales": ["en-US", "en-GB"],
        "invocation": "smart pantry",
        "carriers": [
            "if", "to", "that", "i", "we", "is", "are", "do", "does", "there",
            "what", "how much", "how many", "where",
            "add", "mark", "put", "remove", "check", "buy",
            "the", "a", "an", "some", "my", "in the",
            "can you", "tell me", "please", "yes",
        ],
        "yes": ["yes", "yeah", "sure", "okay", "yes please", "correct", "that's right", "confirm"],
        "no": ["no", "no thanks", "not now", "never mind", "nothing"],
        "more": ["and then", "go on", "continue", "keep going", "what else", "more", "next"],
    },
}

BUILT_IN = ["AMAZON.CancelIntent", "AMAZON.HelpIntent", "AMAZON.StopIntent", "AMAZON.NavigateHomeIntent"]


def intent_name(lang: str, carrier: str) -> str:
    """Intent names allow only letters and underscores."""
    ascii_word = unicodedata.normalize("NFKD", carrier).encode("ascii", "ignore").decode()
    slug = "".join(c if c.isalpha() else "_" for c in ascii_word).strip("_")
    return f"Quartermaster{lang.upper()}_{slug}"


def model(lang: str) -> dict:
    spec = LOCALES[lang]
    intents = [
        {
            "name": intent_name(lang, carrier),
            "slots": [{"name": "query", "type": "AMAZON.SearchQuery"}],
            "samples": [f"{carrier} {{query}}"],
        }
        for carrier in spec["carriers"]
    ]
    intents += [{"name": name, "samples": []} for name in BUILT_IN]
    intents += [
        {"name": f"Quartermaster{lang.upper()}_reply_yes", "samples": spec["yes"]},
        {"name": f"Quartermaster{lang.upper()}_reply_no", "samples": spec["no"]},
        {"name": f"Quartermaster{lang.upper()}_reply_more", "samples": spec["more"]},
    ]
    return {"interactionModel": {"languageModel": {"invocationName": spec["invocation"], "intents": intents, "types": []}}}


HEADER = """\
# Alexa custom skill for Quartermaster (package for configuration.yaml).
# Generated by scripts/alexa-models: edit the script, not this file.
#
# 1. Set up the skill as in https://www.home-assistant.io/integrations/alexa.intent/
#    (forwarding Lambda with a 10 s timeout, account linking) and import the
#    interaction models of this folder for each locale.
# 2. Add the Quartermaster lines to the Lambda (docs/alexa.md, "One
#    conversation per device"), so each Echo device keeps its own thread.
# 3. Replace REPLACE_WITH_SKILL_ID (amzn1.ask.skill.<...>) below.
# 4. Put this file in your packages folder, or merge it into configuration.yaml,
#    and restart Home Assistant.
#
# Alexa sends only the intent and the slot text, without the carrier word the
# sentence started with ("se", "togli", "if"...). Each carrier word has its own
# intent, and its entry below puts the word back in front of the text, so
# Quartermaster receives the whole sentence. Home Assistant does not pass the
# request locale to intent_script either: the intent name tells the language.
# The launch reply cannot know the locale: it uses the main language of your
# home; change the two texts if needed.
#
# session_key keeps one conversation per Echo device: the Lambda adds the
# device id as the qm_device slot. Without those lines the key is empty and
# all devices of the account share one conversation.
alexa:

intent_script:
  # "Alexa, apri dispensa smart" / "Alexa, open smart pantry": opens the skill
  # and listens.
  REPLACE_WITH_SKILL_ID:
    speech:
      text: "Dimmi"
    reprompt:
      text: "Cosa devo fare?"

  # Session end: nothing to say; kept so Home Assistant does not log an
  # unknown intent.
  REPLACE_WITH_SKILL_ID.SessionEndedRequest:
    speech:
      text: ""
"""

FOOTER = """
  AMAZON.StopIntent:
    speech:
      text: "Va bene"

  AMAZON.CancelIntent:
    speech:
      text: "Va bene"

  AMAZON.HelpIntent:
    speech:
      text: >-
        Puoi dirmi cosa hai finito o comprato, chiedermi cosa manca o cosa
        comprare. Per esempio: chiedi a dispensa smart se ho ancora il latte.
    reprompt:
      text: "Cosa devo fare?"
"""

# The reply is the same for every intent: YAML anchors keep the file short.
FIRST_REPLY = """\
    speech: &qm_speech
      # A reprompt only when the agent asks something keeps the microphone
      # open for the answer; an empty one ends the session.
      text: "{{ action_response.speech }}"
    reprompt: &qm_reprompt
      text: >-
        {{ action_response.reprompt
           if action_response.continue_conversation else '' }}
"""
NEXT_REPLY = """\
    speech: *qm_speech
    reprompt: *qm_reprompt
"""


def entry(name: str, text: str, lang: str, first: bool) -> str:
    return f"""
  {name}:
    action:
      - action: quartermaster.ask
        data:
          text: {json.dumps(text, ensure_ascii=False)}
          channel: alexa
          language: {lang}
          session_key: "{{{{ ('alexa-' ~ qm_device) if qm_device is defined else '' }}}}"
        response_variable: qm
      - stop: ""
        response_variable: qm
{FIRST_REPLY if first else NEXT_REPLY}"""


def intent_script() -> str:
    parts = [HEADER]
    first = True
    for lang, spec in LOCALES.items():
        parts.append(f"\n  # {lang}: one intent per carrier word, then bare yes / no / and then? answers.\n")
        for carrier in spec["carriers"]:
            parts.append(entry(intent_name(lang, carrier), f"{carrier} {{{{ query | default('') }}}}", lang, first))
            first = False
        yes, no = spec["yes"][0], spec["no"][0]
        parts.append(entry(f"Quartermaster{lang.upper()}_reply_yes", yes, lang, False))
        parts.append(entry(f"Quartermaster{lang.upper()}_reply_no", no, lang, False))
        parts.append(entry(f"Quartermaster{lang.upper()}_reply_more", f"{spec['more'][0]}?", lang, False))
    parts.append(FOOTER)
    return "".join(parts)


def files() -> dict[Path, str]:
    out = {OUT / "quartermaster_alexa.yaml": intent_script()}
    for lang, spec in LOCALES.items():
        text = json.dumps(model(lang), ensure_ascii=False, indent=2) + "\n"
        for locale in spec["locales"]:
            out[OUT / f"interaction_model.{locale}.json"] = text
    return out


def main() -> int:
    check = "--check" in sys.argv[1:]
    stale = []
    for path, text in files().items():
        if path.exists() and path.read_text(encoding="utf-8") == text:
            continue
        if check:
            stale.append(path.relative_to(ROOT))
        else:
            path.write_text(text, encoding="utf-8")
            print(f"wrote {path.relative_to(ROOT)}")
    if stale:
        print("Out of date, run scripts/alexa-models:", *stale, sep="\n  ")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
